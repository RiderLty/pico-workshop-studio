# 对外访问地址（必须与 nginx 暴露的地址一致；不要带结尾斜杠）
PUBLIC_BASE_URL=https://workshop.rd5isto.top

# host 网络下只监听本机回环，由 nginx 反代
HOST=127.0.0.1
PORT=27193
DATA_DIR=/data

# 单管理员账号
ADMIN_USERNAME=admin
# 首次启动用它生成哈希；至少 12 位。生成后可改用 ADMIN_PASSWORD_HASH，或保持不动（库里的哈希优先）
ADMIN_PASSWORD=change-me-at-least-12-chars
# 可选：node server/cli.js hash-password '密码' 生成后填这里
# ADMIN_PASSWORD_HASH=

# 会话签名密钥；留空会自动生成 data/session.key（推荐用 openssl rand -base64 32）
SESSION_SECRET=

# 反向代理后开启，才会信任 X-Forwarded-For/Proto
TRUST_PROXY=1

NODE_ENV=production

# 可选：拉取镜像时覆盖（默认 GHCR latest）
# STUDIO_IMAGE=ghcr.io/riderlty/pico-workshop-studio:0.1.0
# STUDIO_IMAGE=docker.io/<dockerhub 用户名>/pico-workshop-studio:latest
# STUDIO_IMAGE=ghcr.nju.edu.cn/riderlty/pico-workshop-studio:latest
